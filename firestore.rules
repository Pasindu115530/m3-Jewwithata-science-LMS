rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getRole() == 'student';
    }

    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    // ─── Users collection ──────────────────────────────────────────────────────
    // Students can only read their own profile.
    // Teachers/Admins can read all student profiles.
    // Writes to users collection are LOCKED to Cloud Functions only (Admin SDK bypasses rules).
    match /users/{userId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && request.auth.uid == userId);
      allow create, update, write: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ─── Classes collection ────────────────────────────────────────────────────
    // Teachers & Admins can create, update, and delete classes.
    // Students can only read classes.
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Zoom Links ────────────────────────────────────────────────────────────
    // Teachers & Admins manage zoom links.
    // Students can read zoom links for their enrolled classes.
    match /zoomLinks/{linkId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Announcements ─────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Payments ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAdminOrTeacher() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdminOrTeacher() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ─── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (isAdminOrTeacher() || resource.data.targetUid == request.auth.uid);
      allow create: if isAdminOrTeacher();
      allow update, delete: if isAdmin();
    }

    // ─── Tutes & Study Materials ─────────────────────────────────────────────
    match /tutes/{tuteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Video Recordings ───────────────────────────────────────────────────
    match /recordings/{recordingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Live Classes ────────────────────────────────────────────────────────
    match /liveClasses/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrTeacher();
    }

    // ─── Attendance ──────────────────────────────────────────────────────────
    match /attendance/{courseClassId}/students/{studentId} {
      allow read: if isAdminOrTeacher() || (isSignedIn() && request.auth.uid == studentId);
      allow write: if isAdminOrTeacher();
    }

    // ─── Student ID Counters ────────────────────────────────────────────────────
    // Used by Cloud Functions to generate sequential student IDs.
    match /counters/{counterId} {
      allow read: if isAdminOrTeacher();
      allow write: if false; // Cloud Functions only
    }

    // ─── Physical Students ───────────────────────────────────────────────────
    match /physicalStudents/{docId} {
      allow read, write: if isAdminOrTeacher();
    }

    // ─── Registration Sessions ────────────────────────────────────────────────
    match /registrationSessions/{phone} {
      allow read, write: if false; // Cloud Functions only (Admin SDK)
    }

    // ─── Student Services ─────────────────────────────────────────────────────
    match /studentServices/{docId} {
      allow read: if isAdminOrTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if false; // Cloud Functions only
    }

    // ─── Service Config (Grade-specific fees) ─────────────────────────────────
    match /serviceConfig/{docId} {
      allow read: if true; // Public read for fee display
      allow write: if isAdminOrTeacher();
    }

    // ─── Audit Log ────────────────────────────────────────────────────────────
    match /auditLog/{docId} {
      allow read: if isAdminOrTeacher();
      allow write: if false; // Cloud Functions only
    }
  }
}
